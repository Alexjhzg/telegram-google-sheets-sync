{
  "name": "bot-telegram-campo",
  "version": "1.0.0",
  "description": "Bot de Telegram para supervisión de personal en campo. Extrae datos de reportes y los registra en Google Sheets.",
  "main": "bot.ts",
  "type": "module",
  "scripts": {
    "start": "tsx bot.ts",
    "build": "tsc --noEmit",
    "test": "tsx --test",
    "db:seed": "tsx scripts/seed_catalog.ts",
    "sheets:setup": "tsx scripts/setup_reporte_diario.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "croner": "^10.0.1",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.11.0",
    "google-spreadsheet": "^4.1.4",
    "grammy": "^1.27.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "keywords": [
    "telegram",
    "bot",
    "google-sheets",
    "supervision",
    "campo"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
