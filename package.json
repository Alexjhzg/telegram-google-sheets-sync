{
  "name": "bot-telegram-campo",
  "version": "1.0.0",
  "description": "Bot de Telegram para supervisión de personal en campo. Extrae datos de reportes y los registra en Google Sheets.",
  "main": "bot.ts",
  "type": "module",
  "scripts": {
    "start": "tsx bot.ts",
    "build": "tsc --noEmit",
    "test": "tsx --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "tsx scripts/seed_catalog.ts",
    "sheets:setup": "tsx scripts/setup_reporte_diario.ts",
    "sheets:standardize-dates": "tsx scripts/estandarizar_fechas_historico.ts",
    "corregir:hoy": "tsx scripts/corregir_reportes_hoy.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "croner": "^10.0.1",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.11.0",
    "google-spreadsheet": "^4.1.4",
    "grammy": "^1.27.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "telegram",
    "bot",
    "google-sheets",
    "supervision",
    "campo"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0"
  }
}
